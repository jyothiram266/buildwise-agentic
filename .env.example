# ---------------------------------------------------------------------------
# BuildWise Agentic AI — environment template.
# Copy to .env and adjust. No real secrets belong in this file.
# ---------------------------------------------------------------------------

# --- Core service ---------------------------------------------------------
APP_ENV=dev                       # dev | prod. prod disables the demo role switcher.
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
API_PORT=8000

# --- Datastores -----------------------------------------------------------
# Inside docker compose the hostnames are the service names.
DATABASE_URL=postgresql://buildwise:buildwise@postgres:5432/buildwise
REDIS_URL=redis://redis:6379/0

# --- Mock systems of record ----------------------------------------------
MOCK_CONNECTOR_URL=http://mock-connectors:8100
CONNECTOR_TIMEOUT_SECONDS=6.0
CONNECTOR_CACHE_TTL_SECONDS=60

# --- Auth (prototype: symmetric key, mock issuer) ------------------------
JWT_SECRET=change-me-in-any-real-deployment
JWT_ISSUER=buildwise-mock-auth
JWT_TTL_MINUTES=720

# --- Language model -------------------------------------------------------
# mock      = deterministic offline provider. No key needed, no network.
# anthropic = requires ANTHROPIC_API_KEY
# openai    = requires OPENAI_API_KEY
LLM_PROVIDER=mock
LLM_MODEL_LARGE=claude-sonnet-4-6
LLM_MODEL_SMALL=claude-haiku-4-5-20251001
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings -----------------------------------------------------------
# local  = deterministic hashed-ngram embeddings (no network, reproducible)
# openai = text-embedding-3-small
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-384
EMBEDDING_DIM=384

# --- Reranker -------------------------------------------------------------
# heuristic = built-in lexical/entity cross-scorer (default, no downloads)
# cross_encoder = sentence-transformers model, requires the `rerank` extra
RERANKER=heuristic
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Thresholds and policy knobs -----------------------------------------
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.70
AGENT_CONFIDENCE_THRESHOLD=0.70
SLIPPAGE_FLAG_DAYS=14
RETRIEVAL_K=20
RERANK_TOP_N=5
COST_ALERT_USD_PER_CASE=0.25
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
TIMEZONE=Asia/Kolkata

# --- Frontend -------------------------------------------------------------
# Leave blank when the API serves the built SPA from the same origin.
VITE_API_BASE_URL=
