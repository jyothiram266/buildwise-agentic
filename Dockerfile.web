# The build plan names a separate web image (P0-T4). The main Dockerfile can also
# bundle the frontend into the API image for single-service hosting; this one exists
# for deployments that serve the console separately behind a CDN or static host.
FROM node:22-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY web/ ./
RUN npm run build

# nginx rather than `vite preview`: preview is a dev convenience and not something
# to put in front of users.
FROM nginx:1.27-alpine AS runtime
COPY --from=build /web/dist /usr/share/nginx/html
# SPA routing: unknown paths return index.html, but /api is proxied to the API
# service so the browser still sees one origin.
RUN printf '%s\n' \
  'server {' \
  '  listen 3000;' \
  '  root /usr/share/nginx/html;' \
  '  location /api/ { proxy_pass http://api:8000; proxy_set_header Host $host; }' \
  '  location /health { proxy_pass http://api:8000/health; }' \
  '  location / { try_files $uri $uri/ /index.html; }' \
  '}' > /etc/nginx/conf.d/default.conf
EXPOSE 3000
HEALTHCHECK --interval=20s --timeout=5s --retries=5 \
  CMD wget -qO- http://localhost:3000/ >/dev/null || exit 1
